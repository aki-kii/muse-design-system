{
  "$description": "Muse DS のデザイントークン。Design Tokens Community Group 形式（$value / $type）。primitive は値そのもの、semantic は役割の名前で primitive を参照する。ダークモードの値は $extensions.com.muse.modes.dark に持つ。tokens.css はこのファイルから scripts/build-tokens.mjs で作る。",
  "primitive": {
    "color": {
      "$type": "color",
      "neutral": {
        "0": { "$value": "#FFFFFF" },
        "25": { "$value": "#F0F0F2" },
        "50": { "$value": "#EDEEF0" },
        "200": { "$value": "#D2D6DC" },
        "300": { "$value": "#C2C7CE" },
        "400": { "$value": "#8E939A" },
        "550": { "$value": "#656A72" },
        "700": { "$value": "#454D56" },
        "750": { "$value": "#3E4248" },
        "850": { "$value": "#232527" },
        "900": { "$value": "#17181A" },
        "950": { "$value": "#0B0D10" },
        "1000": { "$value": "#000000" }
      },
      "blue": {
        "25": { "$value": "#EAF4FF" },
        "50": { "$value": "#E7F3FE" },
        "100": { "$value": "#D9EBFF" },
        "300": { "$value": "#8FC2FF" },
        "400": { "$value": "#5CA8FF" },
        "600": { "$value": "#0073E6" },
        "700": { "$value": "#0064D1" },
        "850": { "$value": "#0E3A5F" },
        "900": { "$value": "#0C2D4D" },
        "950": { "$value": "#12293F" }
      },
      "red": {
        "50": { "$value": "#FDECEA" },
        "400": { "$value": "#FF6B5E" },
        "600": { "$value": "#D92D20" },
        "950": { "$value": "#3A1D1A" }
      },
      "green": {
        "50": { "$value": "#E2F2EA" },
        "400": { "$value": "#3ECF8E" },
        "700": { "$value": "#12805C" },
        "950": { "$value": "#12291F" }
      },
      "orange": {
        "500": { "$value": "#F08A24" }
      },
      "teal": {
        "700": { "$value": "#0E7C86" }
      },
      "pink": {
        "500": { "$value": "#E5487B" }
      },
      "gold": {
        "400": { "$value": "#FFC933" },
        "500": { "$value": "#F5B400" },
        "900": { "$value": "#4A3200" },
        "950": { "$value": "#2A1E00" }
      },
      "scrim": {
        "40": { "$value": "rgba(0, 0, 0, 0.4)" },
        "70": { "$value": "rgba(0, 0, 0, 0.7)" }
      }
    },
    "font": {
      "family": {
        "$type": "fontFamily",
        "sans": { "$value": ["Figtree", "Noto Sans JP", "Hiragino Sans", "sans-serif"] },
        "mono": { "$value": ["ui-monospace", "SF Mono", "Menlo", "monospace"] }
      },
      "weight": {
        "$type": "fontWeight",
        "regular": { "$value": 400 },
        "semibold": { "$value": 600 },
        "bold": { "$value": 700 },
        "extrabold": { "$value": 800 }
      },
      "size": {
        "$type": "dimension",
        "2xs": { "$value": "11px" },
        "xs": { "$value": "12px" },
        "sm": { "$value": "14px" },
        "base": { "$value": "16px" },
        "lg": { "$value": "18px" },
        "xl": { "$value": "20px" },
        "2xl": { "$value": "24px" },
        "3xl": { "$value": "30px" },
        "4xl": { "$value": "36px" },
        "5xl": { "$value": "48px" }
      },
      "line-height": {
        "$type": "dimension",
        "2xs": { "$value": "14px" },
        "xs": { "$value": "16px" },
        "sm": { "$value": "20px" },
        "base": { "$value": "24px" },
        "lg": { "$value": "28px" },
        "xl": { "$value": "28px" },
        "2xl": { "$value": "32px" },
        "3xl": { "$value": "36px" },
        "4xl": { "$value": "40px" },
        "5xl": { "$value": "52px" }
      }
    },
    "space": {
      "4": { "$value": "4px" },
      "8": { "$value": "8px" },
      "12": { "$value": "12px" },
      "16": { "$value": "16px" },
      "44": { "$value": "44px" },
      "$type": "dimension"
    },
    "radius": {
      "6": { "$value": "6px" },
      "12": { "$value": "12px" },
      "20": { "$value": "20px" },
      "$type": "dimension",
      "pill": { "$value": "999px" }
    }
  },
  "semantic": {
    "color": {
      "$type": "color",
      "bg": {
        "$value": "{primitive.color.neutral.50}",
        "$description": "ページ全体の背景",
        "$extensions": { "com.muse.modes": { "dark": "{primitive.color.neutral.1000}" } }
      },
      "surface": {
        "$value": "{primitive.color.neutral.0}",
        "$description": "カードの面",
        "$extensions": { "com.muse.modes": { "dark": "{primitive.color.neutral.900}" } }
      },
      "fill": {
        "$value": "{primitive.color.neutral.25}",
        "$description": "控えめな面。チップ・第2ボタン・数値タイル。--surface の上（カード・シートの中）だけで使う",
        "$extensions": { "com.muse.modes": { "dark": "{primitive.color.neutral.850}" } }
      },
      "text": {
        "$value": "{primitive.color.neutral.950}",
        "$description": "見出しと本文（v0.3 の ink）",
        "$extensions": { "com.muse.modes": { "dark": "{primitive.color.neutral.0}" } }
      },
      "dim": {
        "$value": "{primitive.color.neutral.700}",
        "$description": "説明文・メタ情報（v0.3 の ink-2）",
        "$extensions": { "com.muse.modes": { "dark": "{primitive.color.neutral.300}" } }
      },
      "faint": {
        "$value": "{primitive.color.neutral.550}",
        "$description": "時刻・注記・完了した項目の題。--bg・--surface・--fill のどれに置いても 4.5:1 以上",
        "$extensions": { "com.muse.modes": { "dark": "{primitive.color.neutral.400}" } }
      },
      "border": {
        "$value": "{primitive.color.neutral.200}",
        "$description": "罫線・区切り（v0.3 の line）",
        "$extensions": { "com.muse.modes": { "dark": "{primitive.color.neutral.750}" } }
      },
      "accent": {
        "$value": "{primitive.color.blue.600}",
        "$description": "主操作・選択中・進捗・リンクだけに使うブルー",
        "$extensions": { "com.muse.modes": { "dark": "{primitive.color.blue.400}" } }
      },
      "accent-ink": {
        "$value": "{primitive.color.neutral.0}",
        "$description": "accent の面に載せる文字",
        "$extensions": { "com.muse.modes": { "dark": "{primitive.color.neutral.950}" } }
      },
      "accent-strong": {
        "$value": "{primitive.color.blue.700}",
        "$description": "ブルーの文字。ゴーストボタン・選択中の文字（v0.3 の blue-ink）",
        "$extensions": { "com.muse.modes": { "dark": "{primitive.color.blue.300}" } }
      },
      "accent-soft": {
        "$value": "{primitive.color.blue.50}",
        "$description": "選択中の背景。フォーカスの輪には使わない（輪は --accent）",
        "$extensions": { "com.muse.modes": { "dark": "{primitive.color.blue.950}" } }
      },
      "danger": {
        "$value": "{primitive.color.red.600}",
        "$description": "削除・拒否・エラーと、録音中・未送信の件数だけ",
        "$extensions": { "com.muse.modes": { "dark": "{primitive.color.red.400}" } }
      },
      "danger-ink": {
        "$value": "{primitive.color.neutral.0}",
        "$description": "danger の面に載せる文字・アイコン",
        "$extensions": { "com.muse.modes": { "dark": "{primitive.color.neutral.950}" } }
      },
      "danger-soft": {
        "$value": "{primitive.color.red.50}",
        "$description": "不正解・エラーの薄い面",
        "$extensions": { "com.muse.modes": { "dark": "{primitive.color.red.950}" } }
      },
      "ok": {
        "$value": "{primitive.color.green.700}",
        "$description": "完了・成功（やりとりが片付いた、正解）",
        "$extensions": { "com.muse.modes": { "dark": "{primitive.color.green.400}" } }
      },
      "ok-ink": {
        "$value": "{primitive.color.neutral.0}",
        "$description": "ok の面に載せる文字・アイコン",
        "$extensions": { "com.muse.modes": { "dark": "{primitive.color.neutral.950}" } }
      },
      "ok-soft": {
        "$value": "{primitive.color.green.50}",
        "$description": "正解・成功の薄い面",
        "$extensions": { "com.muse.modes": { "dark": "{primitive.color.green.950}" } }
      },
      "bubble-user": {
        "$value": "{primitive.color.blue.600}",
        "$description": "本人の吹き出しの面（accent と同じブルー）",
        "$extensions": { "com.muse.modes": { "dark": "{primitive.color.blue.400}" } }
      },
      "bubble-user-ink": {
        "$value": "{primitive.color.neutral.0}",
        "$description": "本人の吹き出しの文字とメタ行",
        "$extensions": { "com.muse.modes": { "dark": "{primitive.color.neutral.950}" } }
      },
      "gold": {
        "$value": "{primitive.color.gold.500}",
        "$description": "達成の面と飾り（完了したノード、XP の ★、祝福の帯）。文字の色には使わない",
        "$extensions": { "com.muse.modes": { "dark": "{primitive.color.gold.400}" } }
      },
      "gold-ink": {
        "$value": "{primitive.color.gold.900}",
        "$description": "gold の面に載せる文字・★",
        "$extensions": { "com.muse.modes": { "dark": "{primitive.color.gold.950}" } }
      },
      "scrim": {
        "$value": "{primitive.color.scrim.40}",
        "$description": "幕（軽い）。パネル・下から出るシートの後ろ"
      },
      "scrim-strong": {
        "$value": "{primitive.color.scrim.70}",
        "$description": "幕（重い）。キーボードと一緒に出る入力のシートの後ろ"
      },
      "cal-common": {
        "$value": "{primitive.color.orange.500}",
        "$description": "中身側の色: 家族カレンダー「共通」。予定行のバーと凡例だけ"
      },
      "cal-self": {
        "$value": "{primitive.color.teal.700}",
        "$description": "中身側の色: 家族カレンダー「自分」。予定行のバーと凡例だけ"
      },
      "cal-partner": {
        "$value": "{primitive.color.pink.500}",
        "$description": "中身側の色: 家族カレンダー「パートナー」。予定行のバーと凡例だけ"
      }
    },
    "shadow": {
      "$type": "shadow",
      "card": {
        "$value": "none",
        "$description": "廃止（v0.12.0）。影は使わない。次の MINOR 版で消す（決定記録 0009）",
        "$deprecated": true
      },
      "float": {
        "$value": "none",
        "$description": "廃止（v0.12.0）。影は使わない。次の MINOR 版で消す（決定記録 0009）",
        "$deprecated": true
      }
    },
    "radius": {
      "$type": "dimension",
      "small": {
        "$value": "{primitive.radius.6}",
        "$description": "小物・小角"
      },
      "row": {
        "$value": "{primitive.radius.12}",
        "$description": "行・入力欄"
      },
      "card": {
        "$value": "{primitive.radius.20}",
        "$description": "カード・吹き出し"
      },
      "pill": {
        "$value": "{primitive.radius.pill}",
        "$description": "ボタン・チップ・タブバー・トースト"
      }
    },
    "space": {
      "$type": "dimension",
      "inner": {
        "$value": "{primitive.space.4}",
        "$description": "要素内の最小間隔"
      },
      "row": {
        "$value": "{primitive.space.8}",
        "$description": "チップ同士・行の上下"
      },
      "card-gap": {
        "$value": "{primitive.space.12}",
        "$description": "カード同士の間隔"
      },
      "card-padding": {
        "$value": "{primitive.space.16}",
        "$description": "カードの内側（標準）"
      },
      "section": {
        "$value": "{primitive.space.44}",
        "$description": "セクションの間隔"
      }
    },
    "size": {
      "$type": "dimension",
      "tap-target": {
        "$value": "44px",
        "$description": "タップ範囲の最小"
      }
    },
    "font": {
      "family": {
        "$type": "fontFamily",
        "sans": { "$value": "{primitive.font.family.sans}" },
        "mono": { "$value": "{primitive.font.family.mono}" }
      }
    }
  }
}
