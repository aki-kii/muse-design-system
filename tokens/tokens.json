{
  "$description": "Muse DS v0.3 のデザイントークン。Design Tokens Community Group 形式（$value / $type）。primitive は値そのもの、semantic は役割の名前で primitive を参照する。ダークモードの値は $extensions.com.muse.modes.dark に持つ。tokens.css はこのファイルから scripts/build-tokens.mjs で作る。",
  "primitive": {
    "color": {
      "$type": "color",
      "neutral": {
        "0": { "$value": "#FFFFFF" },
        "25": { "$value": "#F0F0F2" },
        "50": { "$value": "#EDEEF0" },
        "200": { "$value": "#D2D6DC" },
        "300": { "$value": "#C2C7CE" },
        "500": { "$value": "#8A8D91" },
        "600": { "$value": "#6E7278" },
        "700": { "$value": "#454D56" },
        "750": { "$value": "#3E4248" },
        "850": { "$value": "#232527" },
        "900": { "$value": "#17181A" },
        "950": { "$value": "#0B0D10" },
        "1000": { "$value": "#000000" }
      },
      "blue": {
        "25": { "$value": "#EAF4FF" },
        "50": { "$value": "#E7F3FE" },
        "100": { "$value": "#D9EBFF" },
        "300": { "$value": "#8FC2FF" },
        "400": { "$value": "#5CA8FF" },
        "600": { "$value": "#0073E6" },
        "700": { "$value": "#0064D1" },
        "850": { "$value": "#0E3A5F" },
        "900": { "$value": "#0C2D4D" },
        "950": { "$value": "#12293F" }
      },
      "red": {
        "400": { "$value": "#FF6B5E" },
        "600": { "$value": "#D92D20" }
      },
      "green": {
        "700": { "$value": "#12805C" }
      },
      "orange": {
        "500": { "$value": "#F08A24" }
      },
      "teal": {
        "700": { "$value": "#0E7C86" }
      },
      "pink": {
        "500": { "$value": "#E5487B" }
      }
    },
    "font": {
      "family": {
        "$type": "fontFamily",
        "sans": { "$value": ["Figtree", "Noto Sans JP", "Hiragino Sans", "sans-serif"] },
        "mono": { "$value": ["ui-monospace", "SF Mono", "Menlo", "monospace"] }
      },
      "weight": {
        "$type": "fontWeight",
        "regular": { "$value": 400 },
        "semibold": { "$value": 600 },
        "bold": { "$value": 700 },
        "extrabold": { "$value": 800 }
      },
      "size": {
        "$type": "dimension",
        "xs": { "$value": "12px" },
        "sm": { "$value": "14px" },
        "base": { "$value": "16px" },
        "lg": { "$value": "18px" },
        "xl": { "$value": "20px" },
        "2xl": { "$value": "24px" },
        "3xl": { "$value": "30px" },
        "4xl": { "$value": "36px" },
        "5xl": { "$value": "48px" }
      },
      "line-height": {
        "$type": "dimension",
        "xs": { "$value": "16px" },
        "sm": { "$value": "20px" },
        "base": { "$value": "24px" },
        "lg": { "$value": "28px" },
        "xl": { "$value": "28px" },
        "2xl": { "$value": "32px" },
        "3xl": { "$value": "36px" },
        "4xl": { "$value": "40px" },
        "5xl": { "$value": "52px" }
      }
    },
    "space": {
      "$type": "dimension",
      "4": { "$value": "4px" },
      "8": { "$value": "8px" },
      "14": { "$value": "14px" },
      "18": { "$value": "18px" },
      "44": { "$value": "44px" }
    },
    "radius": {
      "$type": "dimension",
      "6": { "$value": "6px" },
      "12": { "$value": "12px" },
      "20": { "$value": "20px" },
      "pill": { "$value": "999px" }
    },
    "shadow": {
      "$type": "shadow",
      "card-light": { "$value": "0 1px 2px rgba(17,19,24,.05), 0 8px 24px -14px rgba(17,19,24,.18)" },
      "card-dark": { "$value": "0 1px 2px rgba(0,0,0,.35), 0 8px 24px -14px rgba(0,0,0,.5)" },
      "float-light": { "$value": "0 2px 6px rgba(17,19,24,.08), 0 14px 34px -12px rgba(17,19,24,.22)" },
      "float-dark": { "$value": "0 2px 6px rgba(0,0,0,.4), 0 14px 34px -12px rgba(0,0,0,.6)" }
    }
  },
  "semantic": {
    "color": {
      "$type": "color",
      "bg": {
        "$value": "{primitive.color.neutral.50}",
        "$description": "ページ全体の背景",
        "$extensions": { "com.muse.modes": { "dark": "{primitive.color.neutral.1000}" } }
      },
      "surface": {
        "$value": "{primitive.color.neutral.0}",
        "$description": "カードの面",
        "$extensions": { "com.muse.modes": { "dark": "{primitive.color.neutral.900}" } }
      },
      "fill": {
        "$value": "{primitive.color.neutral.25}",
        "$description": "控えめな面。チップ・第2ボタン・数値タイル",
        "$extensions": { "com.muse.modes": { "dark": "{primitive.color.neutral.850}" } }
      },
      "text": {
        "$value": "{primitive.color.neutral.950}",
        "$description": "見出しと本文（v0.3 の ink）",
        "$extensions": { "com.muse.modes": { "dark": "{primitive.color.neutral.0}" } }
      },
      "dim": {
        "$value": "{primitive.color.neutral.700}",
        "$description": "説明文・メタ情報（v0.3 の ink-2）",
        "$extensions": { "com.muse.modes": { "dark": "{primitive.color.neutral.300}" } }
      },
      "faint": {
        "$value": "{primitive.color.neutral.500}",
        "$description": "時刻・注記（v0.3 の ink-3）。本文には使わない",
        "$extensions": { "com.muse.modes": { "dark": "{primitive.color.neutral.600}" } }
      },
      "border": {
        "$value": "{primitive.color.neutral.200}",
        "$description": "罫線・区切り（v0.3 の line）",
        "$extensions": { "com.muse.modes": { "dark": "{primitive.color.neutral.750}" } }
      },
      "accent": {
        "$value": "{primitive.color.blue.600}",
        "$description": "主操作・選択中・進捗・リンクだけに使うブルー",
        "$extensions": { "com.muse.modes": { "dark": "{primitive.color.blue.400}" } }
      },
      "accent-ink": {
        "$value": "{primitive.color.neutral.0}",
        "$description": "accent の面に載せる文字",
        "$extensions": { "com.muse.modes": { "dark": "{primitive.color.neutral.950}" } }
      },
      "accent-strong": {
        "$value": "{primitive.color.blue.700}",
        "$description": "ブルーの文字。ゴーストボタン・選択中の文字（v0.3 の blue-ink）",
        "$extensions": { "com.muse.modes": { "dark": "{primitive.color.blue.300}" } }
      },
      "accent-soft": {
        "$value": "{primitive.color.blue.50}",
        "$description": "選択中の背景・フォーカスの輪",
        "$extensions": { "com.muse.modes": { "dark": "{primitive.color.blue.950}" } }
      },
      "danger": {
        "$value": "{primitive.color.red.600}",
        "$description": "削除・拒否・エラーだけ",
        "$extensions": { "com.muse.modes": { "dark": "{primitive.color.red.400}" } }
      },
      "ok": {
        "$value": "{primitive.color.green.700}",
        "$description": "完了・成功"
      },
      "bubble-user": {
        "$value": "{primitive.color.blue.100}",
        "$description": "本人の吹き出しの面",
        "$extensions": { "com.muse.modes": { "dark": "{primitive.color.blue.850}" } }
      },
      "bubble-user-ink": {
        "$value": "{primitive.color.blue.900}",
        "$description": "本人の吹き出しの文字",
        "$extensions": { "com.muse.modes": { "dark": "{primitive.color.blue.25}" } }
      },
      "cal-common": {
        "$value": "{primitive.color.orange.500}",
        "$description": "中身側の色: 家族カレンダー「共通」。予定行のバーと凡例だけ"
      },
      "cal-self": {
        "$value": "{primitive.color.teal.700}",
        "$description": "中身側の色: 家族カレンダー「自分」。予定行のバーと凡例だけ"
      },
      "cal-partner": {
        "$value": "{primitive.color.pink.500}",
        "$description": "中身側の色: 家族カレンダー「パートナー」。予定行のバーと凡例だけ"
      }
    },
    "shadow": {
      "$type": "shadow",
      "card": {
        "$value": "{primitive.shadow.card-light}",
        "$description": "カードの控えめな影",
        "$extensions": { "com.muse.modes": { "dark": "{primitive.shadow.card-dark}" } }
      },
      "float": {
        "$value": "{primitive.shadow.float-light}",
        "$description": "浮く部品（タブバー・トースト）の影",
        "$extensions": { "com.muse.modes": { "dark": "{primitive.shadow.float-dark}" } }
      }
    },
    "radius": {
      "$type": "dimension",
      "small": { "$value": "{primitive.radius.6}", "$description": "小物・小角" },
      "row": { "$value": "{primitive.radius.12}", "$description": "行・入力欄" },
      "card": { "$value": "{primitive.radius.20}", "$description": "カード・吹き出し" },
      "pill": { "$value": "{primitive.radius.pill}", "$description": "ボタン・チップ・タブバー・トースト" }
    },
    "space": {
      "$type": "dimension",
      "inner": { "$value": "{primitive.space.4}", "$description": "要素内の最小間隔" },
      "row": { "$value": "{primitive.space.8}", "$description": "チップ同士・行の上下" },
      "card-gap": { "$value": "{primitive.space.14}", "$description": "カード同士の間隔" },
      "card-padding": { "$value": "{primitive.space.18}", "$description": "カードの内側（標準）" },
      "section": { "$value": "{primitive.space.44}", "$description": "セクションの間隔" }
    },
    "size": {
      "$type": "dimension",
      "tap-target": { "$value": "44px", "$description": "タップ範囲の最小" }
    },
    "font": {
      "family": {
        "$type": "fontFamily",
        "sans": { "$value": "{primitive.font.family.sans}" },
        "mono": { "$value": "{primitive.font.family.mono}" }
      }
    }
  }
}
